{
	"name": "project-c",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig tsconfig.json --watch",
		"test": "vitest",
		"lint": "prettier --plugin-search-dir project-c --check . && eslint .",
		"format": "prettier --plugin-search-dir project-c --write ."
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@typescript-eslint/eslint-plugin": "8.71.1",
		"@typescript-eslint/parser": "8.71.1",
		"@typescript/native": "npm:typescript@^7.0.2",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.0",
		"prettier": "3.9.9",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.1",
		"svelte-check": "4.7.6",
		"tslib": "2.8.1",
		"typescript": "6.0.3",
		"vite": "^8.3.3",
		"vitest": "^5.0.3"
	},
	"type": "module",
	"dependencies": {
		"@egjs/svelte-grid": "^1.18.0"
	}
